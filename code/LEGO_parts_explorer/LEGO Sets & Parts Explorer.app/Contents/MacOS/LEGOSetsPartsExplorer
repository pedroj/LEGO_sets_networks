#!/bin/bash
# LEGO Sets & Parts Explorer launcher (v1.3)
# No fixed paths: the R code is inside this bundle (Contents/Resources/app) and the
# data tables (.rds) are read from the folder that contains the .app. Move the
# folder anywhere and the app keeps working (keep the .app next to the .rds files).
# Always opens in Safari. R stops a few seconds after the last tab is closed.

CODE_DIR="$(cd "$(dirname "$0")/../Resources/app" && pwd)"
BUNDLE="$(cd "$(dirname "$0")/../.." && pwd)"
DATA_DIR="$(dirname "$BUNDLE")"
PORT=8766
URL="http://127.0.0.1:${PORT}"
TITLE="LEGO Sets & Parts Explorer"
TRACE="$DATA_DIR/launcher_trace.log"
LOG="$DATA_DIR/launcher_R.log"
if ! touch "$TRACE" 2>/dev/null; then              # folder not writable: log in ~/Library/Logs
    TRACE="$HOME/Library/Logs/LEGOSetsPartsExplorer_trace.log"
    LOG="$HOME/Library/Logs/LEGOSetsPartsExplorer_R.log"
fi
exec 2>>"$TRACE"
echo "=== $(date) launch (v1.3) from $BUNDLE" >> "$TRACE"
echo "DATA_DIR=$DATA_DIR" >> "$TRACE"

# data present?
if [ ! -f "$DATA_DIR/set_parts.rds" ] && [ ! -f "$DATA_DIR/parts_index.rds" ]; then
    osascript -e "display notification \"First launch: downloading Rebrickable tables (1–3 minutes)…\" with title \"$TITLE\""
fi

# stop an older copy still serving the port (only the listening R server)
OLD=$(lsof -nP -iTCP:${PORT} -sTCP:LISTEN -t 2>/dev/null)
if [ -n "$OLD" ]; then
    echo "stopping old server pid(s): $OLD" >> "$TRACE"; kill $OLD 2>/dev/null; sleep 1
fi

for R in /Library/Frameworks/R.framework/Resources/bin/Rscript \
         /usr/local/bin/Rscript /opt/homebrew/bin/Rscript; do
    [ -x "$R" ] && RSCRIPT="$R" && break
done
if [ -z "$RSCRIPT" ]; then
    osascript -e "display alert \"$TITLE\" message \"Rscript was not found. Install R from CRAN.\""
    exit 1
fi

cd "$CODE_DIR" || { echo "cannot cd to $CODE_DIR" >> "$TRACE"; exit 1; }

start_r() {
    LEGO_DATA_DIR="$DATA_DIR" LEGO_DESKTOP=1 "$RSCRIPT" $1 -e "
for (p in c('shiny','DT','data.table','later')) if (!requireNamespace(p, quietly = TRUE)) install.packages(p, repos = 'https://cloud.r-project.org')
shiny::runApp('.', port = ${PORT}, launch.browser = FALSE)" > "$LOG" 2>&1 &
    RPID=$!
    echo "R started ($1) pid $RPID" >> "$TRACE"
}
start_r --no-init-file
RETRIED=0
trap 'kill $RPID 2>/dev/null' TERM INT EXIT

T0=$(date +%s)
for i in $(seq 1 1440); do
    if curl -s -o /dev/null "$URL"; then
        echo "server up after $(( $(date +%s) - T0 ))s, opening Safari" >> "$TRACE"
        open -a Safari "$URL"; break
    fi
    if ! kill -0 $RPID 2>/dev/null; then
        if [ $RETRIED -eq 0 ]; then
            RETRIED=1; echo "R stopped early; retrying with .Rprofile" >> "$TRACE"
            start_r ""; continue
        fi
        osascript -e "display alert \"$TITLE\" message \"The app failed to start. See the log: $LOG\""
        exit 1
    fi
    sleep 0.25
done

wait $RPID
echo "R exited ($(date))" >> "$TRACE"
